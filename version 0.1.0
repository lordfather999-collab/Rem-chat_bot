import string

def cleaned_text(user_input):
	xabar = user_input.lower( ).strip( )
	for char in string.punctuation:
		xabar = xabar.replace(char , " ")
		return xabar
def chatbot( ):
	print("=" * 40)
	print("Salom, Rem aloqada!")
	print("pryom, pryom")
	print("\nSuxbatni yakunlash uchun [X] yozing")
	print("=" * 40)

while True:  
	user_input = input("\nSiz: ")  
	xabar = cleaned_text(user_input)  
	if xabar == "x":  
		print("Koʻrishguncha xayr!")  
		break  
	print("Rem: coming soon.." , xabar)

def main( ):
	chatbot( )
main( )